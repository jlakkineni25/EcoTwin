{
  "model": "WA-TGCN dyn_adv (wind-aware hourly graph + upwind transport feature)",
  "seeds": [
    42,
    7,
    123,
    2024,
    999
  ],
  "checkpoints": [
    "watgcn_v5dyn_adv_seed42.pt",
    "watgcn_v5dyn_adv_seed7.pt",
    "watgcn_v5dyn_adv_seed123.pt",
    "watgcn_v5dyn_adv_seed2024.pt",
    "watgcn_v5dyn_adv_seed999.pt"
  ],
  "graph_mode": "dynamic",
  "in_features": 28,
  "feature_cols": [
    "pm2.5",
    "pm10",
    "no2",
    "so2",
    "co",
    "o3",
    "rh",
    "at",
    "u_wind",
    "v_wind",
    "wspd",
    "pm_roll6_mean",
    "pm_roll6_std",
    "pm_roll24_mean",
    "pm_roll24_std",
    "pm_delta3",
    "city_mean_pm",
    "city_max_pm",
    "pm_minus_city",
    "hour_sin",
    "hour_cos",
    "dow_sin",
    "dow_cos",
    "mon_sin",
    "mon_cos",
    "is_weekend",
    "adv_pm",
    "adv_diff"
  ],
  "scaler_30ch": "scalers/v5_feature_scaler.pkl (30 channels; columns 0-27 are used by this model)",
  "log_scaler": "scalers/v3_log_scaler.pkl",
  "hidden_dim": 32,
  "gru_layers": 1,
  "attn_heads": 4,
  "dropout": 0.2,
  "gcn_hops": 2,
  "input_window": 48,
  "horizon": 24,
  "n_stations": 37,
  "n_fut": 10,
  "future_channels": [
    "hour_sin",
    "hour_cos",
    "dow_sin",
    "dow_cos",
    "mon_sin",
    "mon_cos",
    "is_weekend",
    "u_wind",
    "v_wind",
    "wspd"
  ],
  "transport_feature": {
    "threshold_km": 12.0,
    "max_lag_hours": 6,
    "wind": "observed ERA5 wind at the source station",
    "definition": "adv = alignment/distance weighted mean of upwind neighbours PM2.5 at lag = round(dist / (max(align, 0.5) * 3.6)) capped at 6 h; adv_diff = adv - own PM2.5"
  },
  "future_wind_live": "real day-old forecast wind (Open-Meteo previous-day-1 / forecast API) and forecast-wind graph",
  "loss_vol_alpha": 1.0,
  "split": {
    "train_end_index": 13944,
    "val_end_index": 16932,
